// pecia_ai.rc - Windows resource script for PeciaAIChat only.
// Uses the AI bot icon (ai_bot.ico) instead of the Pecia logo.
// Paths are relative to this .rc file's location (main/build/).
#include <windows.h>
#include "resource.h"

IDI_PECIA ICON "../image/ai_bot.ico"

// Application manifest - enable modern controls + UTF-8 active codepage
1 24 "pecia.manifest"
